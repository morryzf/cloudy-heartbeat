# ─── Anthropic API ───
ANTHROPIC_API_KEY=sk-ant-你的key

# 模型 (默认 claude-sonnet-4-6)
MODEL_NAME=claude-sonnet-4-6

# ─── Bark 推送 ───
BARK_KEY=你的BarkKey
# BARK_SERVER=https://api.day.app  # 默认值，自建 Bark 服务可改
# CUSTOM_ICON_URL=https://你的图标URL

# ─── Ombre Brain MCP (Phase 2) ───
# OMBRE_MCP_URL=https://ombre-morry.zeabur.app/mcp

# ─── 管理页面 ───
ADMIN_USER=cloudy
ADMIN_PASSWORD=设一个强密码

# ─── 端口 (Zeabur 会自动设置) ───

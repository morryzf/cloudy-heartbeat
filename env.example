# ─── LLM API (中转站) ───
TARGET_API_URL=https://api.jiushi.xin/v1/chat/completions
TARGET_API_KEY=你的中转站API密钥
MODEL_NAME=你的模型名称

# ─── Bark 推送 ───
BARK_KEY=8mnmfD7zRxYycFaeQWMamT
# CUSTOM_ICON_URL=https://你的图标URL

# ─── 管理页面 ───
ADMIN_USER=cloudy
ADMIN_PASSWORD=设一个强密码

# ─── 唤醒策略 ───
# 白天：9:00-00:00，沉默150分钟后唤醒，每5分钟检查一次
WAKE_DAY_START_HOUR=9
WAKE_DAY_END_HOUR=24
DAY_WAKE_AFTER_MINUTES=150
DAY_CHECK_INTERVAL_MINUTES=5
# 夜间：00:00-9:00，沉默300分钟后唤醒，每60分钟检查一次
NIGHT_WAKE_AFTER_MINUTES=300
NIGHT_CHECK_INTERVAL_MINUTES=60

# ─── 时区 ───
TIME_ZONE=Asia/Shanghai

# ─── Gateway ───
# Zeabur 上不需要改，wake_up 通过 localhost 连 gateway
# GATEWAY_BASE_URL=http://localhost:3000

# ─── 天气（可选） ───
# WEATHER_ENABLED=true
# WEATHER_LOCATION_NAME=上海
# WEATHER_LAT=31.23
# WEATHER_LON=121.47
# WEATHER_UNITS=metric

# ─── 端口 (Zeabur 自动设置) ───
# PORT=3000
